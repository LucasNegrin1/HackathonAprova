# Copie este arquivo para .env.local e preencha. Tudo é opcional: sem chaves, o sistema roda em modo de demonstração.

# --- Modelo de IA do bot (usa a primeira chave preenchida: Grok → Groq → Claude) ---
# Groq tem plano gratuito: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Grok (xAI): https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Claude (Anthropic): https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Supabase (banco dos chamados) ---
# Project Settings > Data API (URL) e Project Settings > API Keys (chaves).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Token pessoal (https://supabase.com/dashboard/account/tokens), usado só pelos scripts que criam o banco.
SUPABASE_ACCESS_TOKEN=
