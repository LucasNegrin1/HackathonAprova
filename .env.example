# Modelo do bot, escolhido pela primeira chave definida: XAI_API_KEY (Grok) → GROQ_API_KEY (Groq)
# → ANTHROPIC_API_KEY (Claude). Sem nenhuma, roda em modo demonstração com roteiro fixo.
XAI_API_KEY=
XAI_MODEL=grok-4.7
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

ANTHROPIC_API_KEY=
# Esforço do agente: low (padrão, mais rápido no chat), medium ou high
AGENT_EFFORT=low

# WhatsApp Cloud API (Meta). Opcional: o simulador funciona sem isso.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Números (formato 5511999999999) tratados como analistas de prefeitura, separados por vírgula
WHATSAPP_NUMEROS_PREFEITURA=

# Supabase (Project Settings > Data API e API Keys). Sem isso, o painel não mostra a triagem.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Token pessoal (supabase.com/dashboard/account/tokens), só para aplicar migrations:
# node --env-file=.env.local scripts/aplicar-sql.mjs supabase/migrations/*.sql
SUPABASE_ACCESS_TOKEN=
